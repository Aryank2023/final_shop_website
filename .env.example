# Environment Variables Template for MAA VAISHNO VIDEO FILM'S
# Copy this file to .env and configure your production values

# Database Connection (SQLite for local dev or PostgreSQL for production)
# SQLite: file:./dev.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/maavaishno?schema=public
DATABASE_URL="file:./dev.db"

# Admin Authentication Secret (min 32 characters random string)
JWT_SECRET="replace-with-a-very-long-secure-random-secret-key"

# First Administrator Seed Credentials (Used when running db:seed)
ADMIN_DEFAULT_USER="admin"
ADMIN_DEFAULT_PASS="ChangeThisSecurePassword!123"
ADMIN_DEFAULT_EMAIL="admin@maavaishnovideofilms.com"

# Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Email Notification Provider Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your-smtp-password"
NOTIFICATION_EMAIL="owner@example.com"
