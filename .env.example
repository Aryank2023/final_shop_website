# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR MAA VAISHNO VIDEO FILM'S
# Neon PostgreSQL + Cloudflare R2 Production Infrastructure
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON SERVERLESS POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# DATABASE_URL: Neon pooled connection string (with -pooler in hostname)
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[database]?sslmode=require"

# DIRECT_URL: Neon direct unpooled connection string (used for migrations)
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[database]?sslmode=require"

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE R2 OBJECT STORAGE
# ------------------------------------------------------------------------------
# Your Cloudflare Account ID (from right sidebar in Cloudflare Dashboard)
R2_ACCOUNT_ID="your_cloudflare_account_id"

# R2 API Token Access Key ID & Secret Access Key
# (Generated in Cloudflare Dashboard > R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# The name of your R2 bucket created in Cloudflare Dashboard
R2_BUCKET_NAME="maa-vaishno-media"

# Public URL domain for media delivery (Custom Domain or R2 pub-*.r2.dev URL)
# Example: "https://media.maavaishnovideofilms.com" or "https://pub-abc123xyz.r2.dev"
R2_PUBLIC_URL="https://media.maavaishnovideofilms.com"

# ------------------------------------------------------------------------------
# 3. ADMIN AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secure random string (min 32 characters) for signing admin JWT tokens
JWT_SECRET="replace-with-a-very-long-secure-random-secret-key-min-32-chars"

# Default credentials for first-time database seed (run `npm run db:seed`)
ADMIN_DEFAULT_USER="admin"
ADMIN_DEFAULT_PASS="ChangeThisSecurePassword!123"
ADMIN_DEFAULT_EMAIL="admin@maavaishnovideofilms.com"

# ------------------------------------------------------------------------------
# 4. APPLICATION & NOTIFICATIONS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Email Notification Provider (SMTP or Resend)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
NOTIFICATION_EMAIL="contact@maavaishnovideofilms.com"
