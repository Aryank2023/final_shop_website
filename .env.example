# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE FOR MAA VAISHNO VIDEO FILM'S
# Next.js 14 + Neon PostgreSQL + ImageKit Production Infrastructure
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON SERVERLESS POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# DATABASE_URL: Neon pooled connection string (with -pooler in hostname)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# DIRECT_URL: Neon direct connection string (used for schema migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ------------------------------------------------------------------------------
# 2. IMAGEKIT MEDIA & STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Public Key from ImageKit Dashboard -> Developer Options -> API Keys
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxxxxxxxxxxxxxxxxx="

# Private Key from ImageKit Dashboard -> Developer Options -> API Keys
# CAUTION: Keep this secret; never expose on client-side
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxxxxxxxxx="

# URL Endpoint from ImageKit Dashboard (e.g., https://ik.imagekit.io/your_id)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# ------------------------------------------------------------------------------
# 3. ADMIN AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Cryptographically secure random secret (minimum 32 characters) for signing JWT tokens
JWT_SECRET="generate-a-strong-random-secret-key-at-least-32-characters-long"

# ------------------------------------------------------------------------------
# 4. BREVO EMAIL NOTIFICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Brevo (formerly Sendinblue) Transactional Email REST API configuration (src/lib/email.ts).
# When customers submit an inquiry, an email alert is sent to the studio notification address.
# If BREVO_API_KEY is omitted, inquiries are still saved to PostgreSQL and email delivery is safely skipped.

# Brevo v3 API Key (from Brevo Dashboard -> SMTP & API -> API Keys)
BREVO_API_KEY=""

# Verified sender email address in your Brevo account
BREVO_SENDER_EMAIL="maavaishnovideofilm@gmail.com"

# Sender display name appearing in email clients
BREVO_SENDER_NAME="MAA VAISHNO VIDEO FILM'S"

# Destination email address to receive incoming customer inquiry alerts
NOTIFICATION_EMAIL="maavaishnovideofilm@gmail.com"

# ------------------------------------------------------------------------------
# 5. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Base URL of the website (used for metadataBase, canonical URLs, and sitemap generation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
